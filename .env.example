# LOAD MANASSES: server configuration.
# Copy to .env and adjust. Everything is optional: with no env at all the app runs
# in mock mode on the fictional example knowledge.

# ── AI ────────────────────────────────────────────────────────────────────────
# Leave empty for mock mode (canned answers, no costs).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high. Chat answers are short; low keeps them fast and cheap.
ANTHROPIC_EFFORT=low
MAX_OUTPUT_TOKENS=1024

# ── Knowledge ─────────────────────────────────────────────────────────────────
# Folder with public/ and private/ markdown files and persona.json.
# Defaults to ./knowledge, falls back to ./knowledge.example if that is missing.
KNOWLEDGE_DIR=./knowledge

# ── Private tier ──────────────────────────────────────────────────────────────
# Create with: npm run hash-code   (empty = no private tier)
ACCESS_CODE_HASH=
# At least 32 random characters, e.g. from: openssl rand -base64 48
# Without it, unlocked sessions end whenever the server restarts.
SESSION_SECRET=
SESSION_TTL_HOURS=168
UNLOCK_MAX_ATTEMPTS=5
UNLOCK_WINDOW_MINUTES=15

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=500
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=120
# Hard daily budget for API calls in USD, reset at midnight Swiss time.
DAILY_SPEND_CAP_USD=1.00
# Persists the spend counter across restarts (recommended in production).
DATA_DIR=./data

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# true only behind exactly one reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Shown in the UI (ABOUT) and mentioned by the bot when asked about its prompt.
PUBLIC_REPO_URL=
# Typing speed of mock answers in ms per word.
MOCK_DELAY_MS=12
